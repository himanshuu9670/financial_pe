# Staging environment — copy to .env.staging (never commit secrets)
# Used with: docker compose -f deployment/docker/docker-compose.staging.yml --env-file .env.staging

APP_ENV=staging
DEBUG=false
AUTH_DISABLED=false

# Generate: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_STAGING_JWT_SECRET_MIN_32_CHARS
SECRET_KEY=REPLACE_STAGING_APP_SECRET_MIN_32_CHARS

POSTGRES_USER=pdf_editor
POSTGRES_PASSWORD=REPLACE_STAGING_DB_PASSWORD
POSTGRES_DB=pdf_editor_db

DATABASE_URL=postgresql+psycopg2://pdf_editor:REPLACE_STAGING_DB_PASSWORD@postgres:5432/pdf_editor_db
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Public staging URL (browser + CORS)
CORS_ORIGINS=https://staging.your-domain.com,http://localhost

# Frontend build-time API (nginx proxies /api — use same origin in staging)
VITE_API_BASE_URL=/api/v1

REDIS_CACHE_ENABLED=true
CACHE_TTL_OCR=86400
CACHE_TTL_EXTRACTION=3600
CACHE_TTL_AI=1800

AI_AUTO_ANALYZE_AFTER_PARSE=true
RATE_LIMIT_ENABLED=true

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

STORAGE_BACKEND=local

# Nginx / TLS
HTTP_PORT=80
HTTPS_PORT=443
TLS_ENABLED=false
# When TLS_ENABLED=true, mount certs to deployment/docker/certs/
# DOMAIN=staging.your-domain.com

GRAFANA_PASSWORD=REPLACE_STAGING_GRAFANA
