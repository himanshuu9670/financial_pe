# Production environment — copy to .env.production (never commit secrets)

APP_ENV=production
DEBUG=false
AUTH_DISABLED=false

JWT_SECRET_KEY=REPLACE_WITH_64_CHAR_SECRET
SECRET_KEY=REPLACE_WITH_64_CHAR_SECRET

DATABASE_URL=postgresql+psycopg2://user:pass@postgres:5432/pdf_editor_db
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

CORS_ORIGINS=https://your-domain.com

REDIS_CACHE_ENABLED=true
CACHE_TTL_EXTRACTION=3600
CACHE_TTL_AI=1800

PDF_PAGE_BATCH_SIZE=25
PDF_MAX_PAGES_IN_MEMORY=500

AI_AUTO_ANALYZE_AFTER_PARSE=true

RATE_LIMIT_UPLOAD=20/hour
RATE_LIMIT_EXPORT=40/hour
RATE_LIMIT_EXTRACT=120/hour
RATE_LIMIT_AI=60/hour

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

STORAGE_BACKEND=local
# STORAGE_BACKEND=s3
# S3_BUCKET=statementforge-prod
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

POSTGRES_USER=pdf_editor
POSTGRES_PASSWORD=REPLACE
POSTGRES_DB=pdf_editor_db
GRAFANA_PASSWORD=REPLACE
HTTP_PORT=80
