# =============================================================================
# Financial PDF Editor — Environment Variables
# Copy to .env and adjust for local or Docker development
# =============================================================================

# Application
APP_NAME=Financial PDF Editor
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production

# Auth (Phase 8) — set AUTH_DISABLED=false in production
AUTH_DISABLED=true
JWT_SECRET_KEY=change-me-jwt-secret-min-32-chars-long-in-production
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7
SECURE_DOWNLOAD_EXPIRE_MINUTES=15

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_UPLOAD=20/hour
RATE_LIMIT_AUTH=30/minute
RATE_LIMIT_EXPORT=40/hour

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL
POSTGRES_USER=pdf_editor
POSTGRES_PASSWORD=pdf_editor_secret
POSTGRES_DB=pdf_editor_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host port mapped by Docker (default 5433 avoids conflict with local PostgreSQL on 5432)
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+psycopg2://pdf_editor:pdf_editor_secret@postgres:5432/pdf_editor_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# File storage (relative to project root or absolute path)
STORAGE_ROOT=./storage
STORAGE_ORIGINAL=./storage/original_pdfs
STORAGE_EDITED=./storage/edited_pdfs
STORAGE_SNAPSHOTS=./storage/snapshots
STORAGE_EXPORTS=./storage/exports
STORAGE_PREVIEWS=./storage/previews
STORAGE_TEMP=./storage/temp
STORAGE_LOGS=./storage/logs

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Logging
LOG_LEVEL=INFO

# Upload limits
MAX_UPLOAD_SIZE_MB=50

# Phase 9 — AI intelligence
AI_EMBEDDINGS_DIM=64
AI_CACHE_EMBEDDINGS=true
AI_AUTO_ANALYZE_AFTER_PARSE=true

# Phase 10 — performance & caching
REDIS_CACHE_ENABLED=true
CACHE_TTL_EXTRACTION=3600
CACHE_TTL_OCR=86400
CACHE_TTL_AI=1800
CACHE_TTL_TRANSACTIONS=3600
CACHE_TTL_PREVIEW=300
PDF_PAGE_BATCH_SIZE=25
PDF_MAX_PAGES_IN_MEMORY=500
RATE_LIMIT_EXTRACT=120/hour
RATE_LIMIT_AI=60/hour
SENTRY_DSN=
STORAGE_BACKEND=local
