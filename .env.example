# =============================================================================
# Financial PDF Editor — Environment Variables
# Copy to .env and adjust for local or Docker development
# =============================================================================

# Application
APP_NAME=Financial PDF Editor
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL
POSTGRES_USER=pdf_editor
POSTGRES_PASSWORD=pdf_editor_secret
POSTGRES_DB=pdf_editor_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://pdf_editor:pdf_editor_secret@postgres:5432/pdf_editor_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# File storage (relative to project root or absolute path)
STORAGE_ROOT=./storage
STORAGE_ORIGINAL=./storage/original_pdfs
STORAGE_EDITED=./storage/edited_pdfs
STORAGE_PREVIEWS=./storage/previews
STORAGE_TEMP=./storage/temp
STORAGE_LOGS=./storage/logs

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Logging
LOG_LEVEL=INFO

# Upload limits
MAX_UPLOAD_SIZE_MB=50
